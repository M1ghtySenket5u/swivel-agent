# ---- Swivel Agent configuration ----
# Copy to .env and fill in. NEVER commit .env.

# Google AI Studio key -- https://aistudio.google.com/apikey
# Leave billing DISABLED to stay on the free tier.
# VERIFIED WORKING: gemini-flash-lite-latest, gemini-3.1-flash-lite,
# gemini-flash-latest, gemini-3-flash-preview all return 200.
# NOTE: the Search tool is NOT available on free tier (429 on every model).
# gemini-2.5-flash / 2.5-flash-lite return 404 "no longer available to new users".
GEMINI_API_KEY=

# ElevenLabs key -- https://elevenlabs.io/app/settings/api-keys
# Free tier works: ~10,000 credits/month. Keep 1 voice only.
ELEVENLABS_API_KEY=

# Voice verified working on the free tier (HTTP 200):
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Set to 0 to force the offline deterministic engine (good for tests)
USE_GEMINI=1